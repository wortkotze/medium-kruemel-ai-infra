# ──────────────────────────────────────────────
# LiteLLM Proxy – Environment Variables Template
# ──────────────────────────────────────────────
# Copy this file to .env:
#   cp .env.example .env

COMPOSE_PROJECT_NAME=litellm_local

# ─── LiteLLM Gateway Security ─────────────────
# Master API key used to authenticate against the LiteLLM Proxy admin & endpoints
LITELLM_MASTER_KEY=sk-CHANGE_ME

# Dedicated virtual API key for Krümel AI Chat UI (Open WebUI)
OPEN_WEBUI_API_KEY=sk-CHANGE_ME_OR_AUTO_GENERATED

# Secret key for Open WebUI sessions/JWT (generate with: openssl rand -hex 32)
WEBUI_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Port the proxy listens on
PORT=4000

# Memgraph Knowledge Graph Studio (Web Lab UI)
MEMGRAPH_LAB_PORT=1515

# Agent Automation & Execution Tier
BROWSERLESS_PORT=1516
SANDBOX_PORT=1517
SEARXNG_PORT=1514

# Log level: INFO (default) or DEBUG (verbose troubleshooting)
LITELLM_LOG=INFO

# ─── PostgreSQL Backend (Telemetry, UI, Memory & Audit) ───
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=your-secure-random-key-here

# ─── Cloud LLM Providers (Fallbacks) ──────────
# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME

# ─── MCP Server Credentials & Token Scoping ───
# 1. Cloudflare MCP (Infra / Zero Trust)
CLOUDFLARE_API_TOKEN=cf_api_token_CHANGE_ME
CLOUDFLARE_EMAIL=admin@example.com
CLOUDFLARE_ACCOUNT_ID=cf_account_id_CHANGE_ME

# 2. GitHub MCPs (Role-Based Token Separation)
# Read-Only PAT for standard developers & research agents
GITHUB_READONLY_TOKEN=github_pat_readonly_CHANGE_ME

# Scoped DevOps PAT with PR creation & triage permissions
GITHUB_DEVOPS_TOKEN=github_pat_devops_CHANGE_ME

# Legacy single token fallback
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_CHANGE_ME

# 3. Web Search MCPs
BRAVE_API_KEY=bsa_CHANGE_ME
SERPER_API_KEY=serper_CHANGE_ME

# 4. Google Workspace & Drive MCP
GOOGLE_WORKSPACE_ACCESS_TOKEN=ya29.CHANGE_ME
GOOGLE_PROJECT_ID=my-google-cloud-project-id

# 5. FRITZ!Box Home Network & Smart Home MCP
# IP address or domain of FRITZ!Box (default: 192.168.178.1 or fritz.box)
FRITZBOX_HOST=192.168.178.1
FRITZBOX_PORT=49000
# FRITZ!Box user & password (create under: System > FRITZ!Box-Benutzer)
FRITZBOX_USER=
FRITZBOX_PASSWORD=your-secure-random-key-here
FRITZBOX_USE_SSL=false

# ─── Monitoring, Observability & Alerting ──────
# Webhook URL for budget alerts (>85% spend) or error spikes (Slack / Discord / OpsGenie)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ─── Langfuse Observability Stack (Self-Hosted) ───
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=CHANGE_ME_OPENSSL_HEX_32
LANGFUSE_SALT=CHANGE_ME_OPENSSL_HEX_32
# Encryption key MUST be exactly 64 hex characters (256-bit): openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Host URL for web access
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# Langfuse ClickHouse Analytics credentials (generate: openssl rand -hex 16)
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=your-secure-random-key-here

# Langfuse MinIO S3 Blob Storage credentials (generate: openssl rand -hex 16)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=your-secure-random-key-here

# LiteLLM -> Langfuse integration keys (generated in Langfuse UI: Settings > API Keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

# ─── Qdrant Vector Search Engine (RAG & Memory) ───
QDRANT_URL=http://localhost:6333

